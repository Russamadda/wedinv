# Node.js 24+, private server environment only. Never use NEXT_PUBLIC_ for these.
APP_ORIGIN=http://127.0.0.1:3001
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_PASSWORD_HASH=generate-with-npm-run-admin-password
# Production: false and a dedicated PostgreSQL connection. Use verified TLS.
LOCAL_DEMO=true
DATABASE_URL=
# Only true behind a trusted proxy that replaces inbound X-Forwarded-For.
TRUST_PROXY=false
